<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The on-device model download worker promotes itself to a foreground
      service (dataSync) so the multi-GB download survives app backgrounding.
      The library manifest merges these permissions into the app manifest.
      POST_NOTIFICATIONS is already declared by the app module.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

</manifest>
