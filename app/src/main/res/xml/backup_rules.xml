<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Aivance.
   Excludes sensitive data and cached content from cloud backup.
-->
<full-backup-content>
    <!-- App data to backup -->
    <include domain="sharedpref" path="." />

    <!-- Database (excluding sync state that will rehydrate) -->
    <include domain="database" path="." />

    <!-- Exclude cached or sensitive data -->
    <exclude domain="sharedpref" path="auth_preferences.xml" />
    <exclude domain="sharedpref" path="crypto_key_store.xml" />
    <exclude domain="file" path="cache/" />
    <exclude domain="file" path="no_backup/" />
    <exclude domain="database" path="analytics.db" />
</full-backup-content>
