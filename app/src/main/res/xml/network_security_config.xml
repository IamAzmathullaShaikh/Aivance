<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for Aivance.

    Restricts cleartext traffic in production. Certificate pinning is NOT
    configured here BY DESIGN: it is enforced in code via OkHttp's native
    CertificatePinner (NetworkModule + AI provider clients), pinned against
    live-verified SPKI hashes in CertificatePins. Keeping pinning in code
    rather than NSC allows the pin set to be updated with an app update and
    avoids double-enforcement that would hard-break on certificate rotation.
    See CertificatePins.kt for the pin registry and rotation runbook.
-->
<network-security-config>
    <!-- Default: HTTPS only, system trust anchors -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug domains: allow cleartext for local development (Ollama local LLM) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
