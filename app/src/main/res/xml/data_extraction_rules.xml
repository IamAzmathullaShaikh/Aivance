<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Aivance (Android 12+).
    Security audit S-05: mirrors backup_rules.xml. The Room database carries
    plaintext PII and encrypted columns keyed by an AndroidKeyStore master key
    that never leaves the device, so it is excluded from cloud backup AND
    device-to-device transfer. Data portability is provided by the in-app
    encrypted export/import feature (BackupExporter). The Tink keyset prefs
    and secrets store are excluded because the wrapping AndroidKeyStore key
    does not transfer with them.
-->
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <cloud-backup>
        <!-- Non-sensitive shared preferences (theme, language, toggles) -->
        <include domain="sharedpref" path="." />

        <!-- Exclude sensitive data -->
        <exclude domain="sharedpref" path="auth_preferences.xml" />
        <exclude domain="sharedpref" path="crypto_key_store.xml" />
        <exclude domain="sharedpref" path="aivance_tink_prefs.xml" />
        <exclude domain="sharedpref" path="aivance_security_prefs.xml" />
        <exclude domain="sharedpref" path="aivance_backup_secure.xml" />

        <!-- Room database: PII + device-keyed encryption — never in cloud backup -->
        <exclude domain="database" path="." tools:ignore="FullBackupContent" />
    </cloud-backup>

    <device-transfer>
        <!-- Non-sensitive shared preferences (theme, language, toggles) -->
        <include domain="sharedpref" path="." />

        <!-- Exclude sensitive data -->
        <exclude domain="sharedpref" path="auth_preferences.xml" />
        <exclude domain="sharedpref" path="crypto_key_store.xml" />
        <exclude domain="sharedpref" path="aivance_tink_prefs.xml" />
        <exclude domain="sharedpref" path="aivance_security_prefs.xml" />
        <exclude domain="sharedpref" path="aivance_backup_secure.xml" />

        <!-- Room database excluded from transfer: encrypted columns are
             unreadable on the destination device (master key stays behind)
             and the DB contains plaintext PII. -->
        <exclude domain="database" path="." tools:ignore="FullBackupContent" />
    </device-transfer>
</data-extraction-rules>
