<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Aivance (Android 12+).
    Excludes sensitive data from cloud backup and device transfer.
    Must remain consistent with backup_rules.xml for API < 31 devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include app data -->
        <include domain="database" path="aivance.db" />
        <include domain="database" path="aivance.db-wal" />
        <include domain="database" path="aivance.db-shm" />
        <include domain="sharedpref" path="." />

        <!-- Exclude sensitive data -->
        <exclude domain="sharedpref" path="auth_preferences.xml" />
        <exclude domain="sharedpref" path="crypto_key_store.xml" />
        <exclude domain="file" path="cache/" />
        <exclude domain="file" path="no_backup/" />
        <exclude domain="database" path="analytics.db" />
        <exclude domain="database" path="analytics.db-wal" />
    </cloud-backup>

    <device-transfer>
        <!-- Include app data for device-to-device transfer -->
        <include domain="database" path="aivance.db" />
        <include domain="database" path="aivance.db-wal" />
        <include domain="sharedpref" path="." />

        <!-- Exclude sensitive data from transfer -->
        <exclude domain="sharedpref" path="auth_preferences.xml" />
        <exclude domain="sharedpref" path="crypto_key_store.xml" />
        <exclude domain="file" path="cache/" />
        <exclude domain="file" path="no_backup/" />
        <exclude domain="database" path="analytics.db" />
        <exclude domain="database" path="analytics.db-wal" />
    </device-transfer>
</data-extraction-rules>
